# Normalise line endings in the repository; keep Windows scripts/installer files CRLF in the working tree.
* text=auto
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.slnx    text eol=crlf
*.iss     text eol=crlf
*.ps1     text eol=crlf
*.md      text
*.json    text

# Binary
*.png  binary
*.jpg  binary
*.ico  binary
